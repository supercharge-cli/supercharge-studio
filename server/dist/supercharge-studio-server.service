# systemd unit for Supercharge Studio Server.
#   sudo install -m755 supercharge-studio-server /usr/local/bin/
#   sudo cp supercharge-studio-server.service /etc/systemd/system/
#   sudo systemctl edit supercharge-studio-server   # set User= and the agent secret
#   sudo systemctl enable --now supercharge-studio-server
#   supercharge-studio-server pair --data-dir /var/lib/supercharge-studio-server
[Unit]
Description=Supercharge Studio Server (encrypted mobile gateway for supercharge agent serve)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=supercharge
Environment=SCS_DATA=/var/lib/supercharge-studio-server
Environment=SCS_BIND=0.0.0.0:2420
Environment=SCS_SPAWN_AGENT=1
# Environment=SCS_RELAY=wss://relay.example.com
# Environment=SUPERCHARGE_AGENT_SECRET=change-me
StateDirectory=supercharge-studio-server
ExecStart=/usr/local/bin/supercharge-studio-server run
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/supercharge-studio-server
PrivateTmp=true

[Install]
WantedBy=multi-user.target
