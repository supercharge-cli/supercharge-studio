# Copy to .env and adjust. All values are optional.
# RELAY_DOMAIN=relay.example.com        # used by the "tls" profile (Caddy)
# RELAY_TRUST_PROXY=1                   # set when behind Caddy/nginx so per-IP limits use X-Forwarded-For
# RELAY_MAX_HOSTS=5000
# RELAY_MAX_CONNS=20000
# RELAY_MAX_CONNS_PER_IP=64
# RELAY_CONN_RATE_PER_MIN=120
# RELAY_MAX_LANES_PER_HOST=8
# RELAY_LANE_BYTES_PER_SEC=2097152
# RELAY_MAX_FRAME=262144
# RELAY_IDLE_SECS=120
# RELAY_BINDING_TTL_DAYS=90
# RELAY_STATS_TOKEN=change-me           # protects GET /v1/stats
