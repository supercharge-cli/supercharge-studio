{
  "name": "supercharge-studio",
  "private": true,
  "version": "1.0.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "agent": "supercharge agent --always-approve serve --bind 127.0.0.1:2419 --secret dev-secret",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "smoke": "vite-node scripts/smoke.ts",
    "fake-agent": "vite-node scripts/fake-agent.ts --",
    "e2e": "playwright test",
    "live": "vite-node scripts/live.ts",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "build:mobile": "tsc -b && vite build --config vite.mobile.config.ts",
    "android:init": "tauri android init --config mobile/src-tauri/tauri.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.2",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "preact": "^10.29.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7",
    "ws": "^8.22.0"
  }
}
